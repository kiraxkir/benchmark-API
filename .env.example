# Identifiants MySQL partagés par docker-compose, les 4 API et les scripts Python.
# Copier ce fichier en .env et renseigner le mot de passe (.env n'est pas versionné).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=mri
# Port publié sur l'hôte (dans le réseau Docker, les API utilisent mysql:3306)
MYSQL_HOST_PORT=3307
# Conteneur visé par scripts/db.py (docker exec)
MYSQL_CONTAINER=mysql-dev
